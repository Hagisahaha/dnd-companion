# Copy to .env and fill in from Supabase: Project Settings → API (or "Connect").
# Both values are public by design and ship inside the app; Row Level Security protects the data.
# NEVER put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
